# Azure OpenAI Configuration
AZURE_OPENAI_API_KEY=your_azure_openai_api_key_here
AZURE_OPENAI_ENDPOINT=https://your-resource.openai.azure.com
AZURE_OPENAI_DEPLOYMENT=gpt-5.1-chat
AZURE_OPENAI_API_VERSION=2025-01-01-preview

# TTS (use at least one for audio generation)
# ElevenLabs = primary (best quality)
ELEVENLABS_API_KEY=
# If not set, edge-tts (free) is used

# Default LLM provider
DEFAULT_LLM_PROVIDER=azure_openai

# Authentication (optional for local dev, required for production)
# Leave blank to disable auth (open access for local development)
LOGIN_USERNAME=
LOGIN_PASSWORD=
JWT_SECRET=change-me-to-a-random-string

# CORS allowed origins (comma-separated, default * for local dev)
ALLOWED_ORIGINS=*

# Backend URL (used by frontend in production)
BACKEND_URL=http://localhost:8000

# --- Database (MySQL is primary; SQLite is used automatically when blank) ---
# Format: mysql://user:password@host:port/dbname
MYSQL_URL=mysql://obd_app:CHANGE_ME@localhost:3306/obd_superstar

# --- Cloudflare R2 audio storage ---
# When all five are set, generated audio is uploaded to R2 and served from
# the public URL. Leave blank to keep audio local-only.
R2_ACCOUNT_ID=
R2_ACCESS_KEY=
R2_SECRET_KEY=
R2_BUCKET=obd-audio
R2_PUBLIC_BASE_URL=https://pub-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx.r2.dev

# --- Legacy Supabase (no longer used; kept for backwards-compat reads only) ---
SUPABASE_URL=
SUPABASE_SERVICE_KEY=
SUPABASE_ANON_KEY=
